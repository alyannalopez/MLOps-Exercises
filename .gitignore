# --- Large datasets (34 GB) ---
data/raw/
data/processed/
*.wav
*.mp3
*.flac
*.ogg

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- ML / model artifacts (keep small checkpoints, ignore huge caches) ---
data/processed/feat_cache/
*.pt.backup

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Logs & transient outputs ---
*.log
serve_logs/
serve_registry.json

# --- Local search / tooling state ---
local_search/
.onit/

# --- Big bundled archives ---
pi_bundle.zip

# --- Large pre-trained model binaries (re-downloadable, >50 MB) ---
asr/*.bin
asr/ggml-*.bin

# --- ME2 rebuild: large regenerated intermediates (reproducible via scripts) ---
ME2/data/feats/
ME2/data/reject/

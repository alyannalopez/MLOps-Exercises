# Genie configuration template — copy to .env and fill in your values.
# This file is safe to commit (contains no secrets).

# --- OpenRouter (LLM) --------------------------------------------------------
OPENROUTER_API_KEY=
GENIE_LLM_MODEL=openai/gpt-4o-mini
GENIE_LLM_TEMPERATURE=0.6
GENIE_LLM_MAX_TOKENS=200

# --- Model server (Mac) ------------------------------------------------------
GENIE_ASR_MODEL=mlx-community/whisper-large-v3-turbo
GENIE_TTS_VOICE=af_bella
GENIE_TTS_SPEED=1
GENIE_PORT=8300

# --- Network ------------------------------------------------------------------
GENIE_SERVER_URL=

# --- MCP Server (Raspberry Pi in final deployment) ----------------------------
MCP_PORT=8301
MCP_HOST=127.0.0.1

# --- Audio --------------------------------------------------------------------
# Available input devices on this Mac:
#   0: 联想thinkplus-TH30 (USB webcam mic)
#   2: iPhone Microphone
#   3: Wireless Mic Rx (STEREO ONLY — returns zeros on mono!)
#   4: MacBook Air Microphone (built-in, works on mono)
#
# Leave blank (default) → uses MacBook Air mic (device 4).
GENIE_MIC_DEVICE=
GENIE_SPEAKER_DEVICE=

# --- VAD ----------------------------------------------------------------------
GENIE_VAD_THRESHOLD=0.5
GENIE_MIN_SPEECH_MS=280
GENIE_MIN_SILENCE_MS=400
GENIE_ENDPOINTING_MS=600

# --- Wakeword (optional) ------------------------------------------------------
GENIE_WAKEWORD=genie

# --- Identity -----------------------------------------------------------------
# These fields are shown to users when they ask "who made you?" or similar.
# Leave blank if not configured — Genie will say the information is not available.
GENIE_ASSISTANT_NAME=Genie
GENIE_PROJECT_CREATOR=
GENIE_PROJECT_OWNER=
GENIE_LLM_GATEWAY=OpenRouter

# Social media links (optional) — shown when the user asks about the creator.
# Leave blank if not applicable.
GENIE_SOCIAL_GITHUB=
GENIE_SOCIAL_LINKEDIN=
GENIE_SOCIAL_WEBSITE=
GENIE_SOCIAL_TWITTER=

# --- GitHub Pages publishing (optional) -------------------------------------
# Set these to enable website publishing to GitHub Pages.
# GITHUB_TOKEN needs 'repo' scope for private repositories.
# NEVER commit your actual token — keep it in .env only.
GITHUB_TOKEN=
GITHUB_USERNAME=
GITHUB_PAGES_REPOSITORY=

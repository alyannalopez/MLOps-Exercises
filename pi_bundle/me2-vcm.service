[Unit]
Description=ME2 voice-controlled smart home (wake word + VCM, all local)
After=network.target sound.target

[Service]
Type=simple
# Adjust to where you copied the bundle:
WorkingDirectory=/home/pi/me2/pi_bundle
ExecStart=/home/pi/me2/pi_bundle/.venv/bin/python -m runtime.main --mic
Restart=on-failure
RestartSec=5
User=pi
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
